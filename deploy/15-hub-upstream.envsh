#!/bin/sh
# Sourced by the nginx image entrypoint before envsubst renders nginx.conf.template:
# validates HUB_UPSTREAM (http[s]://host[:port]) and derives the upstream Host header and TLS SNI.

hub_fail() {
	echo "HUB_UPSTREAM must be http://host[:port] or https://host[:port], got '${HUB_UPSTREAM:-<unset>}': $1" >&2
	exit 1
}

case "${HUB_UPSTREAM:-}" in
	http://* | https://*) ;;
	*) hub_fail "missing http:// or https:// scheme" ;;
esac

hub_scheme="${HUB_UPSTREAM%%://*}"
hub_hostport="${HUB_UPSTREAM#*://}"
hub_hostport="${hub_hostport%/}"

printf '%s\n' "$hub_hostport" | LC_ALL=C awk '
	NR == 1 && /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*(:[0-9]+)?$/ { valid = 1 }
	NR == 1 && /^\[[0-9A-Fa-f:.]+\](:[0-9]+)?$/ { valid = index($0, ":") > 0 }
	END { exit !(valid && NR == 1) }
' || hub_fail "only a hostname or bracketed IPv6 address and an optional port are allowed"

case "$hub_hostport" in
	\[*\]:*)
		hub_host="${hub_hostport%%\]*}]"
		hub_port="${hub_hostport##*\]:}"
		;;
	\[*\])
		hub_host="$hub_hostport"
		hub_port=""
		;;
	*:*)
		hub_host="${hub_hostport%%:*}"
		hub_port="${hub_hostport##*:}"
		;;
	*)
		hub_host="$hub_hostport"
		hub_port=""
		;;
esac

[ -n "$hub_host" ] || hub_fail "missing host"
if [ -n "$hub_port" ]; then
	[ "${#hub_port}" -le 5 ] && [ "$hub_port" -ge 1 ] && [ "$hub_port" -le 65535 ] || hub_fail "port must be between 1 and 65535"
fi
case "$hub_scheme:$hub_port" in
	http:80 | https:443) hub_port="" ;;
esac

export HUB_UPSTREAM="${hub_scheme}://${hub_host}${hub_port:+:$hub_port}"
export HUB_UPSTREAM_HOST="${hub_host}${hub_port:+:$hub_port}"
hub_sni="${hub_host#[}"
export HUB_UPSTREAM_SNI="${hub_sni%]}"

echo "hub upstream: $HUB_UPSTREAM (Host: $HUB_UPSTREAM_HOST, SNI: $HUB_UPSTREAM_SNI)"
unset hub_scheme hub_hostport hub_host hub_port hub_sni
