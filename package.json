{
	"name": "huggingfox",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test --project mocked",
		"test:live": "HUB_UPSTREAM=https://huggingface.co playwright test --project live",
		"test:selfhosted": "SELFHOSTED=1 playwright test --project selfhosted",
		"gen:api": "node tools/gen-api.ts",
		"capture:ref": "node tools/reference/capture.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.0",
		"@huggingface/gguf": "^0.4.6",
		"@huggingface/hub": "^2.17.2",
		"@inlang/paraglide-js": "^2.25.4",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.3",
		"dompurify": "^3.4.15",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"highlight.js": "^11.12.0",
		"jsdom": "^30.1.0",
		"katex": "^0.18.7",
		"marked": "^18.0.13",
		"marked-gfm-heading-id": "^4.1.4",
		"marked-highlight": "^2.2.4",
		"marked-katex-extension": "^5.1.13",
		"openapi-typescript": "^7.13.0",
		"parse-diff": "^0.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"proxy-agent": "^6.5.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"yaml": "^2.9.1"
	}
}
